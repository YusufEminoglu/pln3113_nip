<?xml version='1.0' encoding='utf-8'?>
<StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.0.0" xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
  <NamedLayer>
    <Name>NIP_MANIA_PLANI</Name>
    <UserStyle>
      <Title>NIP_MANIA_PLANI</Title>
      <FeatureTypeStyle>
        <Rule>
          <Name>0</Name>
          <Title>NIP_MANIA_PLANI</Title>
          <MaxScaleDenominator>80000</MaxScaleDenominator>
          <PolygonSymbolizer>
            <Fill>
              <GraphicFill>
                <Graphic>
                  <Mark>
                    <WellKnownName>wkt://MULTILINESTRING((0.00 1.09,1.00 1.09),(0.00 -0.09,1.00 -0.09))</WellKnownName>
                    <Fill />
                    <Stroke />
                  </Mark>
                </Graphic>
              </GraphicFill>
            </Fill>
            <Stroke>
              <CssParameter name="stroke">#000000</CssParameter>
              <CssParameter name="stroke-dasharray">0.0</CssParameter>
            </Stroke>
          </PolygonSymbolizer>
        </Rule>
      </FeatureTypeStyle>
    </UserStyle>
  </NamedLayer>
</StyledLayerDescriptor>