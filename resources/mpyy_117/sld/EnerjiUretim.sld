							<ogc:PropertyName>EnerjiTip</ogc:PropertyName>
							<ogc:Literal>TermikSantralAlani</ogc:Literal>
						</ogc:PropertyIsEqualTo>
					</ogc:Filter>
					<PolygonSymbolizer>
						<Fill>
							<GraphicFill>
