										<OnlineResource xlink:type="simple" xlink:href="mpyy-tarama:e6ff4b7e-40e6-44b7-8e0a-60d19db0fbd6.png" />
										<Format>image/png</Format>
									</ExternalGraphic>
								</Graphic>
							</GraphicFill>
